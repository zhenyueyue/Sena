export component PetWindow inherits Window {
    title: "Sena";
    width: 220px;
    height: 240px;
    background: transparent;
    no-frame: true;
    in-out property <bool> keep-on-top: true;
    always-on-top: root.keep-on-top;

    in property <string> activity-label: "Idle";
    in property <string> foreground-label: "Desktop";
    in property <bool> show-laptop: false;
    in property <bool> show-headphones: false;
    in property <bool> is-drowsy: false;
    in property <bool> is-sleeping: false;
    in property <bool> typing-context-active: false;
    in property <bool> music-context-active: false;
    in-out property <int> music-context-phase: 0;

    in-out property <int> animation-clip: 0;
    in-out property <int> animation-frame: 0;
    in property <int> animation-frame-count: 1;
    in property <int> animation-interval-ms: 1000;
    in property <bool> animation-running: false;
    in property <bool> animation-looping: true;

    in property <image> sprite-image;
    in property <bool> use-sprite: false;
    in property <bool> use-spine: false;

    in-out property <bool> interaction-bubble-visible: false;
    in-out property <string> interaction-bubble-text: "";
    in-out property <bool> interaction-animation-active: false;
    in-out property <bool> interaction-reaction-active: false;
    in-out property <int> interaction-reaction-phase: 0;
    in-out property <bool> autonomous-reaction-active: false;
    in-out property <int> autonomous-reaction-phase: 0;
    in-out property <int> autonomous-action: 0;

    property <length> reaction-x: !interaction-reaction-active ? 0px :
        interaction-reaction-phase == 2 ? -2px :
        interaction-reaction-phase == 4 ? 2px :
        interaction-reaction-phase == 6 ? -1px : 0px;
    property <length> reaction-y: !interaction-reaction-active ? 0px :
        interaction-reaction-phase == 1 ? -3px :
        interaction-reaction-phase == 2 ? -7px :
        interaction-reaction-phase == 3 ? -9px :
        interaction-reaction-phase == 4 ? -6px :
        interaction-reaction-phase == 5 ? -3px :
        interaction-reaction-phase == 6 ? -1px : 0px;

    property <length> autonomous-x: !autonomous-reaction-active ? 0px :
        autonomous-action == 1 ?
            autonomous-reaction-phase == 1 ? -1px :
            autonomous-reaction-phase == 2 ? -2px :
            autonomous-reaction-phase == 3 ? -3px :
            autonomous-reaction-phase == 4 ? -3px :
            autonomous-reaction-phase == 5 ? -2px :
            autonomous-reaction-phase == 6 ? -1px : 0px :
        autonomous-action == 2 ?
            autonomous-reaction-phase == 2 ? 1px :
            autonomous-reaction-phase == 3 ? 2px :
            autonomous-reaction-phase == 4 ? 2px :
            autonomous-reaction-phase == 5 ? 1px : 0px :
        autonomous-action == 3 ?
            autonomous-reaction-phase == 2 ? -1px :
            autonomous-reaction-phase == 3 ? -2px :
            autonomous-reaction-phase == 4 ? -2px :
            autonomous-reaction-phase == 5 ? -1px : 0px : 0px;
    property <length> autonomous-y: !autonomous-reaction-active ? 0px :
        autonomous-action == 0 ?
            autonomous-reaction-phase == 1 ? -2px :
            autonomous-reaction-phase == 2 ? -5px :
            autonomous-reaction-phase == 3 ? -8px :
            autonomous-reaction-phase == 4 ? -8px :
            autonomous-reaction-phase == 5 ? -5px :
            autonomous-reaction-phase == 6 ? -2px : 0px :
        autonomous-action == 2 || autonomous-action == 3 ?
            autonomous-reaction-phase == 3 ? 1px :
            autonomous-reaction-phase == 4 ? 2px :
            autonomous-reaction-phase == 5 ? 1px : 0px : 0px;

    property <length> context-x: root.typing-context-active ? 1px :
        !root.music-context-active ? 0px :
        root.music-context-phase == 1 ? -1px :
        root.music-context-phase == 2 ? 1px :
        root.music-context-phase == 3 ? 2px :
        root.music-context-phase == 4 ? 0px : 0px;
    property <length> context-y: root.typing-context-active ? 1px :
        !root.music-context-active ? 0px :
        root.music-context-phase == 1 ? -1px :
        root.music-context-phase == 2 ? 0px :
        root.music-context-phase == 3 ? -1px :
        root.music-context-phase == 4 ? 0px : 0px;

    property <length> body-bob: (
        animation-clip == 2 || animation-clip == 3
    ) && Math.mod(animation-frame, 2) == 1 ? -2px : 0px;

    property <length> typing-offset: (
        animation-clip == 1 || animation-clip == 3
    ) && Math.mod(animation-frame, 2) == 1 ? 4px : 0px;

    callback drag-start();
    callback drag-move();
    callback drag-end();
    callback pet-activity();
    callback interact();
    callback animation-tick(int, int);

    music-context-timer := Timer {
        interval: 180ms;
        running: root.music-context-active;

        triggered() => {
            root.music-context-phase = Math.mod(root.music-context-phase + 1, 5);
        }
    }

    autonomous-reaction-timer := Timer {
        interval: 170ms;
        running: root.autonomous-reaction-active;

        triggered() => {
            if root.autonomous-reaction-phase >= 7 {
                root.autonomous-reaction-active = false;
                root.autonomous-reaction-phase = 0;
            } else {
                root.autonomous-reaction-phase += 1;
            }
        }
    }

    reaction-timer := Timer {
        interval: 90ms;
        running: root.interaction-reaction-active;

        triggered() => {
            if root.interaction-reaction-phase >= 7 {
                root.interaction-reaction-active = false;
                root.interaction-reaction-phase = 0;
            } else {
                root.interaction-reaction-phase += 1;
            }
        }
    }

    animation-timer := Timer {
        interval: root.animation-interval-ms * 1ms;
        running: root.animation-running;

        triggered() => {
            if root.animation-frame-count > 1 {
                if root.animation-looping {
                    root.animation-frame = Math.mod(
                        root.animation-frame + 1,
                        root.animation-frame-count
                    );
                    root.animation-tick(root.animation-clip, root.animation-frame);
                } else if root.animation-frame + 1 < root.animation-frame-count {
                    root.animation-frame += 1;
                    root.animation-tick(root.animation-clip, root.animation-frame);
                } else {
                    self.running = false;
                }
            }
        }
    }

    Image {
        visible: root.use-sprite;
        x: root.reaction-x + root.autonomous-x + root.context-x;
        y: root.reaction-y + root.autonomous-y + root.context-y;
        width: parent.width;
        height: parent.height;
        source: root.sprite-image;
        image-fit: contain;
    }

    Text {
        visible: !root.use-spine && root.typing-context-active && root.show-laptop;
        x: 174px;
        y: 82px;
        text: "✦";
        color: #9a9de4;
        font-size: 12px;
    }

    Text {
        visible: !root.use-spine && root.music-context-active && root.show-headphones;
        x: 174px + (root.music-context-phase == 2 ? 2px : 0px);
        y: 70px - (root.music-context-phase * 2px);
        text: "♪";
        color: #a08bd8;
        font-size: 14px;
    }

    TouchArea {
        visible: root.use-sprite;
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.grab;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pet-activity();
                root.drag-start();
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.drag-end();
            } else if event.kind == PointerEventKind.cancel {
                root.drag-end();
            }
        }

        moved => {
            root.drag-move();
        }

        clicked => {
            root.interact();
        }
    }

    TouchArea {
        visible: root.use-spine;
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.grab;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pet-activity();
                root.drag-start();
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.drag-end();
            } else if event.kind == PointerEventKind.cancel {
                root.drag-end();
            }
        }

        moved => {
            root.drag-move();
        }

        clicked => {
            root.interact();
        }
    }

    Rectangle {
        visible: !root.use-sprite && !root.use-spine;
        x: 20px + root.reaction-x + root.autonomous-x + root.context-x;
        y: 28px + root.body-bob + root.reaction-y + root.autonomous-y + root.context-y;
        width: 180px;
        height: 188px;
        border-radius: 88px;
        background: #f6f7fb;
        border-width: 2px;
        border-color: #d8dce8;

        Rectangle {
            visible: !root.is-sleeping;
            x: 42px;
            y: root.is-drowsy ? 76px : 61px;
            width: 24px;
            height: root.is-drowsy ? 10px : 30px;
            border-radius: 12px;
            background: #303442;
        }

        Rectangle {
            visible: !root.is-sleeping;
            x: 114px;
            y: root.is-drowsy ? 76px : 61px;
            width: 24px;
            height: root.is-drowsy ? 10px : 30px;
            border-radius: 12px;
            background: #303442;
        }

        Rectangle {
            visible: root.is-sleeping;
            x: 42px;
            y: 79px;
            width: 24px;
            height: 4px;
            border-radius: 2px;
            background: #303442;
        }

        Rectangle {
            visible: root.is-sleeping;
            x: 114px;
            y: 79px;
            width: 24px;
            height: 4px;
            border-radius: 2px;
            background: #303442;
        }

        Text {
            visible: root.is-sleeping;
            x: 118px + (Math.mod(root.animation-frame, 2) == 1 ? 4px : 0px);
            y: 31px - (Math.mod(root.animation-frame, 2) == 1 ? 3px : 0px);
            text: Math.mod(root.animation-frame, 2) == 1 ? "Zzz" : "Zz";
            color: #737a8e;
            font-size: 15px;
        }

        Rectangle {
            x: 72px;
            y: 111px;
            width: 36px;
            height: 8px;
            border-radius: 4px;
            background: #72788b;
        }

        Rectangle {
            visible: root.show-headphones;
            x: 27px;
            y: 42px;
            width: 126px;
            height: 82px;
            border-radius: 54px;
            background: transparent;
            border-width: 8px;
            border-color: #596174;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 45px;
            y: 103px;
            width: 90px;
            height: 49px;
            border-radius: 7px;
            background: #596174;

            Rectangle {
                x: 7px;
                y: 7px;
                width: 76px;
                height: 33px;
                border-radius: 3px;
                background: #dfe7f5;
            }
        }

        Rectangle {
            visible: root.show-laptop;
            x: 36px;
            y: 150px;
            width: 108px;
            height: 7px;
            border-radius: 4px;
            background: #7b8396;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 50px + root.typing-offset;
            y: 132px;
            width: 24px;
            height: 8px;
            border-radius: 4px;
            background: #8990a2;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 106px - root.typing-offset;
            y: 132px;
            width: 24px;
            height: 8px;
            border-radius: 4px;
            background: #8990a2;
        }

        Text {
            visible: root.show-headphones && Math.mod(root.animation-frame, 2) == 1;
            x: 142px;
            y: 74px - Math.mod(root.animation-frame, 4) * 2px;
            text: "♪";
            color: #747c91;
            font-size: 16px;
        }

        Text {
            x: 20px;
            y: 163px;
            width: 140px;
            horizontal-alignment: center;
            text: root.activity-label;
            color: #646b80;
            font-size: 13px;
        }

        Text {
            x: 20px;
            y: 181px;
            width: 140px;
            horizontal-alignment: center;
            text: root.foreground-label;
            color: #959bad;
            font-size: 10px;
            overflow: elide;
        }

        TouchArea {
            mouse-cursor: MouseCursor.grab;

            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.pet-activity();
                    root.drag-start();
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.drag-end();
                } else if event.kind == PointerEventKind.cancel {
                    root.drag-end();
                }
            }

            moved => {
                root.drag-move();
            }

            clicked => {
                root.interact();
            }
        }
    }

    Text {
        visible: root.autonomous-reaction-active && root.autonomous-action == 0;
        x: 172px;
        y: 60px - (root.autonomous-reaction-phase * 1px);
        text: "～";
        color: #9698bd;
        font-size: 16px;
    }

    Text {
        visible: root.autonomous-reaction-active && root.autonomous-action == 1;
        x: 28px;
        y: 74px;
        text: "♡";
        color: #d7a5c7;
        font-size: 14px;
    }

    Text {
        visible: root.autonomous-reaction-active && root.autonomous-action == 2;
        x: 174px;
        y: 58px - (root.autonomous-reaction-phase * 2px);
        text: "…";
        color: #8d90ab;
        font-size: 16px;
    }

    Text {
        visible: root.autonomous-reaction-active && root.autonomous-action == 3;
        x: 174px;
        y: 62px;
        text: "✦";
        color: #9497df;
        font-size: 14px;
    }

    Text {
        visible: root.interaction-reaction-active;
        x: 25px + (root.interaction-reaction-phase * 1px);
        y: 54px - (root.interaction-reaction-phase * 3px);
        text: "♡";
        color: #d99ac4;
        font-size: 18px;
    }

    Text {
        visible: root.interaction-reaction-active;
        x: 178px - (root.interaction-reaction-phase * 1px);
        y: 66px - (root.interaction-reaction-phase * 2px);
        text: "✦";
        color: #8c8fdf;
        font-size: 15px;
    }

    Rectangle {
        visible: root.interaction-bubble-visible;
        x: 16px;
        y: 8px;
        width: parent.width - 32px;
        height: 42px;
        border-radius: 15px;
        background: #fdfcff;
        border-width: 1px;
        border-color: #d9d6ef;

        Text {
            x: 12px;
            y: 0px;
            width: parent.width - 24px;
            height: parent.height;
            text: root.interaction-bubble-text;
            color: #54566d;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width / 2 - 5px;
            y: parent.height - 1px;
            width: 10px;
            height: 5px;
            border-radius: 5px;
            background: #fdfcff;
        }
    }
}

component SenaButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: 10px;
    background: root.selected ? #7779d9 : (touch.has-hover ? #ecebfa : #f4f3f9);
    border-width: 1px;
    border-color: root.selected ? #7779d9 : (touch.has-hover ? #d9d6f2 : #e6e4ed);

    Text {
        text: root.label;
        color: root.selected ? #ffffff : #56586b;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 66px;
    border-radius: 14px;
    background: touch.has-hover ? #fdfcff : #ffffff;
    border-width: 1px;
    border-color: touch.has-hover ? #dcd9f0 : #e9e7ef;

    Rectangle {
        x: 14px;
        y: 14px;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: root.checked ? #ecebff : #f4f3f7;

        Text {
            text: root.icon;
            color: root.checked ? #6b6ec7 : #858798;
            font-size: 17px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 64px;
        y: 11px;
        width: parent.width - 142px;
        text: root.title;
        color: #343646;
        font-size: 14px;
        font-weight: 600;
    }

    Text {
        x: 64px;
        y: 35px;
        width: parent.width - 142px;
        text: root.description;
        color: #9395a3;
        font-size: 11px;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 64px;
        y: 19px;
        width: 46px;
        height: 28px;
        border-radius: 14px;
        background: root.checked ? #7779d9 : #d9d9e2;

        Rectangle {
            x: root.checked ? 21px : 3px;
            y: 3px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #ffffff;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component GuideCard inherits Rectangle {
    in property <string> step;
    in property <string> title;
    in property <string> description;

    height: 66px;
    border-radius: 12px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e7e8f0;

    Rectangle {
        x: 14px;
        y: 15px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: #e4e5ff;

        Text {
            text: root.step;
            color: #6265bb;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 64px;
        y: 11px;
        width: parent.width - 78px;
        text: root.title;
        color: #343746;
        font-size: 14px;
        font-weight: 600;
    }

    Text {
        x: 64px;
        y: 35px;
        width: parent.width - 78px;
        text: root.description;
        color: #8b8f9f;
        font-size: 11px;
        overflow: elide;
    }
}

export component WelcomeWindow inherits Window {
    title: "欢迎使用 Sena";
    width: 430px;
    height: 440px;
    background: #f7f8fb;

    callback finish-onboarding();

    Text {
        x: 24px;
        y: 22px;
        text: "欢迎认识星奈 ✦";
        color: #2f3240;
        font-size: 23px;
        font-weight: 600;
    }

    Text {
        x: 24px;
        y: 58px;
        width: parent.width - 48px;
        text: "她会安静待在桌面上，这几个操作记住就够用了。";
        color: #898d9d;
        font-size: 12px;
    }

    GuideCard {
        x: 24px;
        y: 94px;
        width: parent.width - 48px;
        step: "01";
        title: "拖动星奈";
        description: "按住角色拖动，可以把她放到你喜欢的位置。";
    }

    GuideCard {
        x: 24px;
        y: 170px;
        width: parent.width - 48px;
        step: "02";
        title: "右键角色";
        description: "快速调整大小、始终置顶，或进入设置。";
    }

    GuideCard {
        x: 24px;
        y: 246px;
        width: parent.width - 48px;
        step: "03";
        title: "看看系统托盘";
        description: "隐藏后星奈仍在运行，可从托盘重新显示。";
    }

    GuideCard {
        x: 24px;
        y: 322px;
        width: parent.width - 48px;
        step: "04";
        title: "按你的习惯设置";
        description: "开机自启、显示状态和置顶都可以随时修改。";
    }

    SenaButton {
        x: parent.width - 130px;
        y: 398px;
        width: 106px;
        height: 30px;
        label: "开始使用";
        selected: true;
        clicked => {
            root.finish-onboarding();
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Sena 设置";
    width: 680px;
    height: 600px;
    background: #f6f4fa;

    in-out property <int> scale-percent: 100;
    in-out property <bool> startup-enabled: false;
    in-out property <bool> keep-on-top: true;
    in-out property <bool> pet-visible: true;
    in-out property <bool> autonomous-behavior-enabled: true;
    in-out property <bool> speech-bubbles-enabled: true;
    in-out property <int> autonomous-frequency: 1;
    in-out property <string> status-message: "";

    callback set-scale(int);
    callback set-startup(bool);
    callback set-keep-on-top(bool);
    callback set-visible(bool);
    callback set-autonomous-behavior(bool);
    callback set-speech-bubbles(bool);
    callback set-autonomous-frequency(int);
    callback close-settings();

    Rectangle {
        x: 20px;
        y: 18px;
        width: parent.width - 40px;
        height: 94px;
        border-radius: 18px;
        background: #ffffff;
        border-width: 1px;
        border-color: #e8e5ef;

        Rectangle {
            x: 16px;
            y: 17px;
            width: 60px;
            height: 60px;
            border-radius: 20px;
            background: #eeecff;

            Text {
                text: "✦";
                color: #7779d9;
                font-size: 29px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 92px;
            y: 20px;
            text: "Sena · 星奈";
            color: #303241;
            font-size: 20px;
            font-weight: 600;
        }

        Text {
            x: 92px;
            y: 51px;
            width: parent.width - 112px;
            text: "让她以你喜欢的方式陪在桌面上";
            color: #9495a5;
            font-size: 12px;
        }

        Text {
            x: parent.width - 46px;
            y: 15px;
            text: "♡";
            color: #d6a7c9;
            font-size: 18px;
        }
    }

    Text {
        x: 24px;
        y: 132px;
        text: "外观与互动";
        color: #777989;
        font-size: 12px;
        font-weight: 600;
    }

    Rectangle {
        x: 20px;
        y: 153px;
        width: 310px;
        height: 100px;
        border-radius: 16px;
        background: #ffffff;
        border-width: 1px;
        border-color: #e9e7ef;

        Text {
            x: 16px;
            y: 13px;
            text: "角色大小";
            color: #373948;
            font-size: 14px;
            font-weight: 600;
        }

        Text {
            x: 16px;
            y: 36px;
            text: "调整星奈在桌面上的显示尺寸";
            color: #999aa8;
            font-size: 11px;
        }

        HorizontalLayout {
            x: 16px;
            y: 58px;
            width: parent.width - 32px;
            height: 32px;
            spacing: 8px;

            SenaButton {
                label: "80%";
                selected: root.scale-percent == 80;
                clicked => {
                    root.scale-percent = 80;
                    root.set-scale(80);
                }
            }

            SenaButton {
                label: "100%";
                selected: root.scale-percent == 100;
                clicked => {
                    root.scale-percent = 100;
                    root.set-scale(100);
                }
            }

            SenaButton {
                label: "120%";
                selected: root.scale-percent == 120;
                clicked => {
                    root.scale-percent = 120;
                    root.set-scale(120);
                }
            }
        }
    }

    ToggleRow {
        x: 20px;
        y: 273px;
        width: 310px;
        icon: "✦";
        title: "自主行为";
        description: "偶尔伸懒腰、发呆或看看猫";
        checked: root.autonomous-behavior-enabled;
        toggled(value) => {
            root.autonomous-behavior-enabled = value;
            root.set-autonomous-behavior(value);
        }
    }

    ToggleRow {
        x: 20px;
        y: 349px;
        width: 310px;
        icon: "…";
        title: "气泡台词";
        description: "点击和自主行为时显示短句";
        checked: root.speech-bubbles-enabled;
        toggled(value) => {
            root.speech-bubbles-enabled = value;
            root.set-speech-bubbles(value);
        }
    }

    Rectangle {
        x: 20px;
        y: 425px;
        width: 310px;
        height: 110px;
        border-radius: 16px;
        background: #ffffff;
        border-width: 1px;
        border-color: #e9e7ef;

        Text {
            x: 16px;
            y: 13px;
            text: "自主频率 · 随昼夜微调";
            color: #373948;
            font-size: 14px;
            font-weight: 600;
        }

        Text {
            x: 16px;
            y: 36px;
            text: root.autonomous-frequency == 0 ? "安静 · 基础约 3–5 分钟" :
                root.autonomous-frequency == 2 ? "活跃 · 基础约 40–75 秒" : "标准 · 基础约 75–135 秒";
            color: #999aa8;
            font-size: 11px;
        }

        HorizontalLayout {
            x: 16px;
            y: 66px;
            width: parent.width - 32px;
            height: 32px;
            spacing: 8px;

            SenaButton {
                label: "安静";
                selected: root.autonomous-frequency == 0;
                clicked => {
                    root.autonomous-frequency = 0;
                    root.set-autonomous-frequency(0);
                }
            }

            SenaButton {
                label: "标准";
                selected: root.autonomous-frequency == 1;
                clicked => {
                    root.autonomous-frequency = 1;
                    root.set-autonomous-frequency(1);
                }
            }

            SenaButton {
                label: "活跃";
                selected: root.autonomous-frequency == 2;
                clicked => {
                    root.autonomous-frequency = 2;
                    root.set-autonomous-frequency(2);
                }
            }
        }
    }

    Text {
        x: 354px;
        y: 132px;
        text: "系统行为";
        color: #777989;
        font-size: 12px;
        font-weight: 600;
    }

    ToggleRow {
        x: 350px;
        y: 153px;
        width: 310px;
        icon: "↗";
        title: "开机自启";
        description: "登录 Windows 后自动启动 Sena";
        checked: root.startup-enabled;
        toggled(value) => {
            root.startup-enabled = value;
            root.set-startup(value);
        }
    }

    ToggleRow {
        x: 350px;
        y: 229px;
        width: 310px;
        icon: "⌃";
        title: "始终置顶";
        description: "让 Sena 保持在其他普通窗口上方";
        checked: root.keep-on-top;
        toggled(value) => {
            root.keep-on-top = value;
            root.set-keep-on-top(value);
        }
    }

    ToggleRow {
        x: 350px;
        y: 305px;
        width: 310px;
        icon: "◉";
        title: "显示桌宠";
        description: "隐藏后仍可从系统托盘重新显示";
        checked: root.pet-visible;
        toggled(value) => {
            root.pet-visible = value;
            root.set-visible(value);
        }
    }

    Rectangle {
        x: 350px;
        y: 391px;
        width: 310px;
        height: 90px;
        border-radius: 16px;
        background: #eeecff;
        border-width: 1px;
        border-color: #dfdcf5;

        Text {
            x: 16px;
            y: 14px;
            text: "小提示";
            color: #6265a8;
            font-size: 13px;
            font-weight: 600;
        }

        Text {
            x: 16px;
            y: 38px;
            width: parent.width - 32px;
            text: "右键星奈或托盘图标，也可以快速调整常用选项。";
            color: #7e7f99;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    Text {
        x: 24px;
        y: 566px;
        width: parent.width - 140px;
        text: root.status-message;
        color: #b15f77;
        font-size: 11px;
        overflow: elide;
    }

    SenaButton {
        x: parent.width - 104px;
        y: 552px;
        width: 80px;
        height: 32px;
        label: "完成";
        selected: true;
        clicked => {
            root.close-settings();
        }
    }
}
