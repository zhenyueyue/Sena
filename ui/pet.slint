export component PetWindow inherits Window {
    title: "Sena";
    width: 220px;
    height: 240px;
    background: transparent;
    no-frame: true;
    in-out property <bool> keep-on-top: true;
    always-on-top: root.keep-on-top;

    in property <string> activity-label: "Idle";
    in property <string> foreground-label: "Desktop";
    in property <bool> show-laptop: false;
    in property <bool> show-headphones: false;
    in property <bool> is-drowsy: false;
    in property <bool> is-sleeping: false;

    in-out property <int> animation-clip: 0;
    in-out property <int> animation-frame: 0;
    in property <int> animation-frame-count: 1;
    in property <int> animation-interval-ms: 1000;
    in property <bool> animation-running: false;
    in property <bool> animation-looping: true;

    in property <image> sprite-image;
    in property <bool> use-sprite: false;

    property <length> body-bob: (
        animation-clip == 2 || animation-clip == 3
    ) && Math.mod(animation-frame, 2) == 1 ? -2px : 0px;

    property <length> typing-offset: (
        animation-clip == 1 || animation-clip == 3
    ) && Math.mod(animation-frame, 2) == 1 ? 4px : 0px;

    callback drag-start();
    callback drag-move();
    callback drag-end();
    callback animation-tick(int, int);

    animation-timer := Timer {
        interval: root.animation-interval-ms * 1ms;
        running: root.animation-running;

        triggered() => {
            if root.animation-frame-count > 1 {
                if root.animation-looping {
                    root.animation-frame = Math.mod(
                        root.animation-frame + 1,
                        root.animation-frame-count
                    );
                    root.animation-tick(root.animation-clip, root.animation-frame);
                } else if root.animation-frame + 1 < root.animation-frame-count {
                    root.animation-frame += 1;
                    root.animation-tick(root.animation-clip, root.animation-frame);
                } else {
                    self.running = false;
                }
            }
        }
    }

    Image {
        visible: root.use-sprite;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.sprite-image;
        image-fit: contain;
    }

    TouchArea {
        visible: root.use-sprite;
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.grab;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-start();
            } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.drag-end();
            } else if event.kind == PointerEventKind.cancel {
                root.drag-end();
            }
        }

        moved => {
            root.drag-move();
        }
    }

    Rectangle {
        visible: !root.use-sprite;
        x: 20px;
        y: 28px + root.body-bob;
        width: 180px;
        height: 188px;
        border-radius: 88px;
        background: #f6f7fb;
        border-width: 2px;
        border-color: #d8dce8;

        Rectangle {
            visible: !root.is-sleeping;
            x: 42px;
            y: root.is-drowsy ? 76px : 61px;
            width: 24px;
            height: root.is-drowsy ? 10px : 30px;
            border-radius: 12px;
            background: #303442;
        }

        Rectangle {
            visible: !root.is-sleeping;
            x: 114px;
            y: root.is-drowsy ? 76px : 61px;
            width: 24px;
            height: root.is-drowsy ? 10px : 30px;
            border-radius: 12px;
            background: #303442;
        }

        Rectangle {
            visible: root.is-sleeping;
            x: 42px;
            y: 79px;
            width: 24px;
            height: 4px;
            border-radius: 2px;
            background: #303442;
        }

        Rectangle {
            visible: root.is-sleeping;
            x: 114px;
            y: 79px;
            width: 24px;
            height: 4px;
            border-radius: 2px;
            background: #303442;
        }

        Text {
            visible: root.is-sleeping;
            x: 118px + (Math.mod(root.animation-frame, 2) == 1 ? 4px : 0px);
            y: 31px - (Math.mod(root.animation-frame, 2) == 1 ? 3px : 0px);
            text: Math.mod(root.animation-frame, 2) == 1 ? "Zzz" : "Zz";
            color: #737a8e;
            font-size: 15px;
        }

        Rectangle {
            x: 72px;
            y: 111px;
            width: 36px;
            height: 8px;
            border-radius: 4px;
            background: #72788b;
        }

        Rectangle {
            visible: root.show-headphones;
            x: 27px;
            y: 42px;
            width: 126px;
            height: 82px;
            border-radius: 54px;
            background: transparent;
            border-width: 8px;
            border-color: #596174;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 45px;
            y: 103px;
            width: 90px;
            height: 49px;
            border-radius: 7px;
            background: #596174;

            Rectangle {
                x: 7px;
                y: 7px;
                width: 76px;
                height: 33px;
                border-radius: 3px;
                background: #dfe7f5;
            }
        }

        Rectangle {
            visible: root.show-laptop;
            x: 36px;
            y: 150px;
            width: 108px;
            height: 7px;
            border-radius: 4px;
            background: #7b8396;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 50px + root.typing-offset;
            y: 132px;
            width: 24px;
            height: 8px;
            border-radius: 4px;
            background: #8990a2;
        }

        Rectangle {
            visible: root.show-laptop;
            x: 106px - root.typing-offset;
            y: 132px;
            width: 24px;
            height: 8px;
            border-radius: 4px;
            background: #8990a2;
        }

        Text {
            visible: root.show-headphones && Math.mod(root.animation-frame, 2) == 1;
            x: 142px;
            y: 74px - Math.mod(root.animation-frame, 4) * 2px;
            text: "♪";
            color: #747c91;
            font-size: 16px;
        }

        Text {
            x: 20px;
            y: 163px;
            width: 140px;
            horizontal-alignment: center;
            text: root.activity-label;
            color: #646b80;
            font-size: 13px;
        }

        Text {
            x: 20px;
            y: 181px;
            width: 140px;
            horizontal-alignment: center;
            text: root.foreground-label;
            color: #959bad;
            font-size: 10px;
            overflow: elide;
        }

        TouchArea {
            mouse-cursor: MouseCursor.grab;

            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.drag-start();
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.drag-end();
                } else if event.kind == PointerEventKind.cancel {
                    root.drag-end();
                }
            }

            moved => {
                root.drag-move();
            }
        }
    }
}

component SenaButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: 9px;
    background: root.selected ? #d8d9ff : #f0f1f7;
    border-width: 1px;
    border-color: root.selected ? #abaeff : #e0e2ea;

    Text {
        text: root.label;
        color: root.selected ? #5456a6 : #4c5060;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 64px;
    border-radius: 11px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e8e9ef;

    Text {
        x: 14px;
        y: 10px;
        width: parent.width - 94px;
        text: root.title;
        color: #343746;
        font-size: 14px;
    }

    Text {
        x: 14px;
        y: 33px;
        width: parent.width - 94px;
        text: root.description;
        color: #8d91a0;
        font-size: 11px;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - 64px;
        y: 18px;
        width: 46px;
        height: 28px;
        border-radius: 14px;
        background: root.checked ? #7779d9 : #d9dbe3;

        Rectangle {
            x: root.checked ? 20px : 3px;
            y: 3px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #ffffff;
        }
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component GuideCard inherits Rectangle {
    in property <string> step;
    in property <string> title;
    in property <string> description;

    height: 66px;
    border-radius: 12px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e7e8f0;

    Rectangle {
        x: 14px;
        y: 15px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: #e4e5ff;

        Text {
            text: root.step;
            color: #6265bb;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 64px;
        y: 11px;
        width: parent.width - 78px;
        text: root.title;
        color: #343746;
        font-size: 14px;
        font-weight: 600;
    }

    Text {
        x: 64px;
        y: 35px;
        width: parent.width - 78px;
        text: root.description;
        color: #8b8f9f;
        font-size: 11px;
        overflow: elide;
    }
}

export component WelcomeWindow inherits Window {
    title: "欢迎使用 Sena";
    width: 430px;
    height: 440px;
    background: #f7f8fb;

    callback finish-onboarding();

    Text {
        x: 24px;
        y: 22px;
        text: "欢迎认识星奈 ✦";
        color: #2f3240;
        font-size: 23px;
        font-weight: 600;
    }

    Text {
        x: 24px;
        y: 58px;
        width: parent.width - 48px;
        text: "她会安静待在桌面上，这几个操作记住就够用了。";
        color: #898d9d;
        font-size: 12px;
    }

    GuideCard {
        x: 24px;
        y: 94px;
        width: parent.width - 48px;
        step: "01";
        title: "拖动星奈";
        description: "按住角色拖动，可以把她放到你喜欢的位置。";
    }

    GuideCard {
        x: 24px;
        y: 170px;
        width: parent.width - 48px;
        step: "02";
        title: "右键角色";
        description: "快速调整大小、始终置顶，或进入设置。";
    }

    GuideCard {
        x: 24px;
        y: 246px;
        width: parent.width - 48px;
        step: "03";
        title: "看看系统托盘";
        description: "隐藏后星奈仍在运行，可从托盘重新显示。";
    }

    GuideCard {
        x: 24px;
        y: 322px;
        width: parent.width - 48px;
        step: "04";
        title: "按你的习惯设置";
        description: "开机自启、显示状态和置顶都可以随时修改。";
    }

    SenaButton {
        x: parent.width - 130px;
        y: 398px;
        width: 106px;
        height: 30px;
        label: "开始使用";
        selected: true;
        clicked => {
            root.finish-onboarding();
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Sena 设置";
    width: 420px;
    height: 430px;
    background: #f7f8fb;

    in-out property <int> scale-percent: 100;
    in-out property <bool> startup-enabled: false;
    in-out property <bool> keep-on-top: true;
    in-out property <bool> pet-visible: true;
    in-out property <string> status-message: "";

    callback set-scale(int);
    callback set-startup(bool);
    callback set-keep-on-top(bool);
    callback set-visible(bool);
    callback close-settings();

    Text {
        x: 24px;
        y: 22px;
        text: "Sena 设置";
        color: #2f3240;
        font-size: 22px;
    }

    Text {
        x: 24px;
        y: 54px;
        width: parent.width - 48px;
        text: "保持桌宠轻量运行，只调整你真正需要的选项。";
        color: #8a8e9d;
        font-size: 12px;
    }

    Text {
        x: 24px;
        y: 92px;
        text: "角色大小";
        color: #464958;
        font-size: 13px;
    }

    HorizontalLayout {
        x: 24px;
        y: 116px;
        width: parent.width - 48px;
        spacing: 10px;

        SenaButton {
            label: "80%";
            selected: root.scale-percent == 80;
            clicked => {
                root.scale-percent = 80;
                root.set-scale(80);
            }
        }

        SenaButton {
            label: "100%";
            selected: root.scale-percent == 100;
            clicked => {
                root.scale-percent = 100;
                root.set-scale(100);
            }
        }

        SenaButton {
            label: "120%";
            selected: root.scale-percent == 120;
            clicked => {
                root.scale-percent = 120;
                root.set-scale(120);
            }
        }
    }

    ToggleRow {
        x: 24px;
        y: 174px;
        width: parent.width - 48px;
        title: "开机自启";
        description: "登录 Windows 后自动启动 Sena";
        checked: root.startup-enabled;
        toggled(value) => {
            root.startup-enabled = value;
            root.set-startup(value);
        }
    }

    ToggleRow {
        x: 24px;
        y: 248px;
        width: parent.width - 48px;
        title: "始终置顶";
        description: "让 Sena 保持在其他普通窗口上方";
        checked: root.keep-on-top;
        toggled(value) => {
            root.keep-on-top = value;
            root.set-keep-on-top(value);
        }
    }

    ToggleRow {
        x: 24px;
        y: 322px;
        width: parent.width - 48px;
        title: "显示桌宠";
        description: "隐藏后仍可从系统托盘重新显示";
        checked: root.pet-visible;
        toggled(value) => {
            root.pet-visible = value;
            root.set-visible(value);
        }
    }

    Text {
        x: 24px;
        y: 397px;
        width: parent.width - 120px;
        text: root.status-message;
        color: #a15c62;
        font-size: 11px;
        overflow: elide;
    }

    SenaButton {
        x: parent.width - 88px;
        y: 388px;
        width: 64px;
        height: 30px;
        label: "关闭";
        clicked => {
            root.close-settings();
        }
    }
}
